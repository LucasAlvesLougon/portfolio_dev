---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = 'Lucas Lougon — Engenharia de software e estudos de caso',
  description = 'Portfólio de Lucas Lougon com projetos publicados e estudos de caso sobre arquitetura, regras de negócio e desenvolvimento de software.',
  ogImage = '/og-image.png',
  canonicalUrl = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#171716" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Display, leitura e código -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
    <script>
      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      const revealSelector = [
        '.portfolio-home .case-overview .featured-heading',
        '.portfolio-home .case-overview .system-stage',
        '.portfolio-home .case-overview .case-notes > div',
        '.portfolio-home .case-overview .case-links',
        '.portfolio-home .section-heading',
        '.portfolio-home .principle-list > div',
        '.portfolio-home .specialty-list > div',
        '.portfolio-home .project-filters',
        '.portfolio-home .project-row',
        '.portfolio-home .timeline-list > li',
        '.portfolio-home .contact-layout > div',
        '.project-reading .project-aside',
        '.project-article > h2',
        '.project-article > h3',
        '.project-article > h4',
        '.project-article > p',
        '.project-article > ul',
        '.project-article > ol',
        '.project-article > pre',
        '.project-article > table',
        '.project-article > blockquote',
        '.project-article > figure',
        '.project-article > img',
        '.project-end-inner',
      ].join(', ');

      let revealObserver: IntersectionObserver | undefined;
      let registerReveals: ((root: Element) => void) | undefined;

      function setupReveals() {
        revealObserver?.disconnect();
        registerReveals = undefined;
        document.documentElement.classList.remove('reveal-ready');

        if (motionPreference.matches || !('IntersectionObserver' in window)) return;

        const main = document.querySelector('main');
        if (!main) return;

        revealObserver = new IntersectionObserver((entries, observer) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        }, { rootMargin: '0px 0px -7% 0px', threshold: 0.01 });

        const observe = (element: Element) => {
          if (element.closest('astro-island') && !element.closest('[data-reveal-ready]')) return;
          element.classList.add('reveal-target');
          if (!element.classList.contains('is-revealed')) revealObserver?.observe(element);
        };

        const register = (root: Element) => {
          if (root.matches(revealSelector)) observe(root);
          root.querySelectorAll(revealSelector).forEach(observe);
        };

        registerReveals = register;
        register(main);
        document.documentElement.classList.add('reveal-ready');
      }

      document.addEventListener('portfolio:content-ready', (event) => {
        if (event.target instanceof Element) registerReveals?.(event.target);
      });
      document.addEventListener('astro:page-load', setupReveals);
      motionPreference.addEventListener('change', setupReveals);
      setupReveals();
    </script>
  </body>
</html>
