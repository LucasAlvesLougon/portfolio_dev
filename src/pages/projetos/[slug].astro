---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { ResumeModal } from '@/components/ResumeModal';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const isMuPonto = project.id.replace(/\.md$/, '') === 'gestao-de-ponto';
const statusLabel = project.data.status === 'concluido'
  ? (isMuPonto ? 'Em produção' : 'Concluído')
  : project.data.status === 'em-desenvolvimento'
    ? 'Em desenvolvimento'
    : 'Em planejamento';
const displayDate = project.data.date
  ? new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${project.data.date}-01T00:00:00Z`))
  : null;
---

<Layout
  title={`${project.data.title} — Estudo de caso | Lucas Lougon`}
  description={project.data.summary}
>
  <Header />

  <main class="project-page">
    <section class="project-hero" aria-labelledby="project-title">
      <div class="project-shell">
        <nav class="project-breadcrumb" aria-label="Localização">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <a href="/#projetos-destaque">Projetos</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{isMuPonto ? 'MuPonto' : project.data.title}</span>
        </nav>

        <div class="project-hero-main">
          <p class:list={['project-state', { 'project-state-live': isMuPonto }]}>
            {statusLabel}{displayDate && <><span aria-hidden="true"> · </span><time datetime={project.data.date}>{displayDate}</time></>}
          </p>
          <h1 id="project-title">{isMuPonto ? 'MuPonto' : project.data.title}</h1>
          {isMuPonto && <p class="project-subtitle">Gestão de ponto eletrônico</p>}
          <p class="project-deck">{project.data.summary}</p>
          <div class="project-hero-actions">
            {project.data.links?.demo && (
              <a class="pill-button pill-button-light" href={project.data.links.demo} target="_blank" rel="noopener noreferrer">Abrir o produto <span aria-hidden="true">↗</span></a>
            )}
            {project.data.links?.repository && (
              <a class="hero-secondary-link" href={project.data.links.repository} target="_blank" rel="noopener noreferrer">Ver repositório <span aria-hidden="true">↗</span></a>
            )}
          </div>
        </div>

        <div class="project-hero-bottom">
          <span>Estudo de caso de engenharia</span>
          <span>{project.data.technologies.slice(0, 3).join(' / ')}</span>
        </div>
      </div>
    </section>

    <section class="project-reading" aria-label="Conteúdo do estudo de caso">
      <div class="project-shell reading-layout">
        <aside class="project-aside" aria-label="Informações do projeto">
          <h2>Visão geral</h2>
          <p>{project.data.summary}</p>
          <h2>Tecnologias</h2>
          <ul>
            {project.data.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
        </aside>

        <article class="markdown-rendered project-article">
          <Content />
        </article>
      </div>
    </section>

    <nav class="project-end" aria-label="Navegação após o estudo de caso">
      <div class="project-shell project-end-inner">
        <a href="/#projetos-destaque">Ver todos os projetos</a>
        <a href="/#contato-rapido">Entrar em contato</a>
      </div>
    </nav>
  </main>

  <Footer />
  <ResumeModal client:load />
</Layout>
