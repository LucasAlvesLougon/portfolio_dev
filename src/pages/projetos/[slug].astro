---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { ResumeModal } from '@/components/ResumeModal';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const statusLabel =
  project.data.status === 'concluido'
    ? 'CONCLUÍDO'
    : project.data.status === 'em-desenvolvimento'
      ? 'EM DESENVOLVIMENTO'
      : 'PLANEJAMENTO';

const statusClass =
  project.data.status === 'concluido'
    ? 'bg-mono-100 dark:bg-mono-900 text-mono-900 dark:text-white border-mono-300 dark:border-mono-700'
    : project.data.status === 'em-desenvolvimento'
      ? 'bg-mono-100 dark:bg-mono-900 text-mono-900 dark:text-white border-mono-300 dark:border-mono-700'
      : 'bg-mono-100 dark:bg-mono-900 text-mono-700 dark:text-mono-300 border-mono-300 dark:border-mono-700';
---

<Layout
  title={`${project.data.title} — Estudo de Caso de Engenharia | Lucas Lougon`}
  description={project.data.summary}
>
  <Header />

  <main class="w-full py-12 px-6 lg:px-12 fine-grid min-h-[80vh]">
    <div class="max-w-4xl mx-auto flex flex-col gap-8 bg-white dark:bg-mono-950 border border-mono-200 dark:border-mono-800 p-6 sm:p-12 shadow-sm">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs font-mono text-mono-500 pb-4 border-b border-mono-200 dark:border-mono-800">
        <a href="/" class="hover:text-mono-900 dark:hover:text-white hover:underline">Início</a>
        <span>/</span>
        <a href="/#projetos-destaque" class="hover:text-mono-900 dark:hover:text-white hover:underline">Projetos</a>
        <span>/</span>
        <span class="text-mono-900 dark:text-white font-semibold uppercase">{project.data.title}</span>
      </nav>

      <!-- Header Meta -->
      <div class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-3">
          <span class={`px-2.5 py-0.5 text-xs font-mono uppercase font-semibold border ${statusClass}`}>
            {statusLabel}
          </span>
          {project.data.date && (
            <span class="text-xs font-mono text-mono-500 bg-mono-100 dark:bg-mono-900 px-2.5 py-0.5 border border-mono-200 dark:border-mono-800">
              {project.data.date}
            </span>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-headline uppercase text-mono-900 dark:text-white leading-tight">
          {project.data.title}
        </h1>
        <p class="text-base sm:text-lg text-mono-600 dark:text-mono-300 leading-relaxed font-normal">
          {project.data.summary}
        </p>

        <!-- Tech Badges -->
        <div class="pt-4 border-t border-mono-200 dark:border-mono-800 flex flex-col gap-3">
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-xs font-mono text-mono-500 mr-1 uppercase">Tecnologias:</span>
            {project.data.technologies.map((t) => (
              <span class="px-2 py-0.5 bg-mono-100 dark:bg-mono-900 text-mono-800 dark:text-mono-200 text-xs font-mono border border-mono-200 dark:border-mono-800">
                [ {t} ]
              </span>
            ))}
          </div>

          {project.data.skills.length > 0 && (
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="text-xs font-mono text-mono-500 mr-1 uppercase">Competências:</span>
              {project.data.skills.map((s) => (
                <span class="px-2 py-0.5 bg-white dark:bg-mono-900 text-mono-700 dark:text-mono-300 border border-mono-200 dark:border-mono-800 text-xs font-mono">
                  {s}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Action Links -->
        <div class="flex flex-wrap gap-3 pt-2">
          {project.data.links?.repository && (
            <a
              href={project.data.links.repository}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 bg-mono-100 dark:bg-mono-900 border border-mono-300 dark:border-mono-700 hover:border-mono-500 text-mono-900 dark:text-white font-mono text-xs font-semibold flex items-center gap-2 transition-all shadow-sm"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                />
              </svg>
              <span>VER CÓDIGO NO GITHUB ↗</span>
            </a>
          )}

          {project.data.links?.demo && (
            <a
              href={project.data.links.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 bg-mono-900 dark:bg-white text-white dark:text-mono-950 font-mono text-xs font-bold flex items-center gap-2 transition-all shadow-sm"
            >
              <span class="material-symbols-outlined text-base">open_in_new</span>
              <span>ACESSAR DEMO ONLINE ↗</span>
            </a>
          )}
        </div>
      </div>

      <!-- Rendered Markdown Body -->
      <div class="pt-8 border-t border-mono-200 dark:border-mono-800">
        <article class="markdown-rendered">
          <Content />
        </article>
      </div>

      <!-- Bottom Navigation Footer -->
      <div class="pt-8 mt-6 border-t border-mono-200 dark:border-mono-800 flex flex-wrap justify-between items-center gap-4 font-mono text-xs">
        <a
          href="/#projetos-destaque"
          class="px-5 py-2.5 bg-mono-100 dark:bg-mono-900 border border-mono-300 dark:border-mono-700 text-mono-900 dark:text-mono-100 hover:bg-mono-200 dark:hover:bg-mono-800 font-semibold transition-all"
        >
          ← Voltar para Todos os Projetos
        </a>

        <a
          href="/#contato-rapido"
          class="text-mono-600 dark:text-mono-400 hover:text-mono-900 dark:hover:text-white hover:underline"
        >
          Falar sobre este projeto com o desenvolvedor →
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <ResumeModal client:load />
</Layout>
