---
import { getTranslations, type Locale } from '@/i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang).footer;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-identity">
      <p>{t.role1}</p>
      <p>{t.role2}</p>
    </div>
    <nav aria-label={t.navAria}>
      <a href={t.homeHref}>{t.home}</a>
      <a href={t.storyHref}>{t.story}</a>
      <a href={t.workHref}>{t.work}</a>
      <a href={t.messageHref}>{t.message}</a>
    </nav>
    <p class="site-footer-location">{t.location}</p>
  </div>
</footer>
