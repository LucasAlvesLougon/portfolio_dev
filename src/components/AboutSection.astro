---
import { getTranslations, type Locale } from '@/i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang).about;
---

<section class="home-section" id="about" aria-labelledby="about-title">
  <div class="home-shell section-layout">
    <div class="section-heading">
      <h2 id="about-title">{t.title}</h2>
      <p>{t.subtitle}</p>
    </div>

    <div class="principle-list">
      {t.principles.map((principle) => (
        <div>
          <h3>{principle.title}</h3>
          <p>{principle.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="home-section home-section-tonal" id="specialties" aria-labelledby="specialties-title">
  <div class="home-shell">
    <div class="section-heading section-heading-inline">
      <h2 id="specialties-title">{t.specialtiesTitle}</h2>
      <p>{t.specialtiesSubtitle}</p>
    </div>
    <div class="specialty-list">
      {t.specialties.map((specialty) => (
        <div>
          <h3>{specialty.title}</h3>
          <p>{specialty.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
