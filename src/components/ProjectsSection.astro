---
import { getCollection } from 'astro:content';
import { ProjectsFilter } from './ProjectsFilter';
import type { ProjectItemData } from './ProjectsFilter';

const projects = await getCollection('projects');
const statusOrder: Record<string, number> = {
  concluido: 1,
  'em-desenvolvimento': 2,
  planejamento: 3,
};

const sortedProjects = projects.sort((a, b) => {
  const byStatus = (statusOrder[a.data.status] || 99) - (statusOrder[b.data.status] || 99);
  return byStatus || (b.data.date || '').localeCompare(a.data.date || '');
});

const serializedProjects: ProjectItemData[] = sortedProjects.map((project) => ({
  slug: project.id.replace(/\.md$/, ''),
  title: project.data.title,
  status: project.data.status,
  date: project.data.date,
  summary: project.data.summary,
  technologies: project.data.technologies,
  links: project.data.links,
}));
---

<section class="home-section" id="projetos-destaque" aria-labelledby="projects-title">
  <div class="home-shell">
    <div class="section-heading section-heading-inline">
      <h2 id="projects-title">Projetos e estudos de caso</h2>
      <p>Do produto publicado às ideias ainda em planejamento.</p>
    </div>
    <ProjectsFilter client:load projects={serializedProjects} />
  </div>
</section>
