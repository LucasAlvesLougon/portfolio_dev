---
import { getCollection } from 'astro:content';
import ProjectsFilter from './ProjectsFilter.astro';

const projects = await getCollection('projects');
const statusOrder: Record<string, number> = {
  completed: 1,
  'in-development': 2,
  planning: 3,
};

const sortedProjects = projects.sort((a, b) => {
  const byStatus = (statusOrder[a.data.status] || 99) - (statusOrder[b.data.status] || 99);
  return byStatus || (b.data.date || '').localeCompare(a.data.date || '');
});

const serializedProjects = sortedProjects.map((project) => ({
  slug: project.id.replace(/\.md$/, ''),
  title: project.data.title,
  status: project.data.status,
  date: project.data.date,
  summary: project.data.summary,
  technologies: project.data.technologies,
  links: project.data.links,
}));
---

<section class="home-section" id="featured-projects" aria-labelledby="projects-title">
  <div class="home-shell">
    <div class="section-heading section-heading-inline">
      <h2 id="projects-title">Projects and case studies</h2>
      <p>From published products to ideas still in planning.</p>
    </div>
    <ProjectsFilter projects={serializedProjects} />
  </div>
</section>
