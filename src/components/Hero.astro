---
import { Image } from 'astro:assets';
import portrait from '@/assets/lucas-lougon.png';
import MobileMenu from './MobileMenu';
---

<section class="editorial-hero" id="hero" aria-labelledby="home-title">
  <Image src={portrait} alt="" width={1000} format="webp" loading="eager" fetchpriority="high" class="editorial-bg-image" />
  <div class="editorial-bg-overlay" aria-hidden="true"></div>

  <div class="editorial-marquee" aria-hidden="true">
    <div class="editorial-marquee-track">
      <span>Lucas &mdash; Lougon&nbsp;</span>
      <span>Lucas &mdash; Lougon&nbsp;</span>
    </div>
  </div>

  <header class="editorial-header">
    <a class="editorial-brand" href="/#hero" aria-label="Lucas Lougon, return to home">Lucas</a>
    <div class="editorial-header-cluster">
      <span class="editorial-year">2026</span>
      <nav aria-label="Site index">
        <a href="#about">Story</a>
        <a href="#featured-projects">Work</a>
        <a href="#contact">Message</a>
      </nav>
      <nav aria-label="Social links">
        <a href="https://www.linkedin.com/in/lucas-lougon" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://github.com/LucasAlvesLougon" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </div>
  </header>

  <h1 id="home-title" class="editorial-visually-hidden">Lucas Lougon - Software engineering portfolio</h1>

  <Image
    src={portrait}
    alt="Portrait of Lucas Lougon"
    width={1000}
    format="webp"
    loading="eager"
    fetchpriority="high"
    class="editorial-front-image"
  />

  <div class="editorial-rule" aria-hidden="true"></div>
  <footer class="editorial-footer">
    <div>
      <p>Software Engineer</p>
      <p>Backend &amp; Full Stack</p>
      <p>APIs, automation, and product systems</p>
    </div>
    <div class="editorial-footer-right">
      <p>Based in</p>
      <p>Espírito Santo, Brazil</p>
    </div>
  </footer>

  <MobileMenu client:load />
</section>

<section class="case-overview" id="caso-muponto" aria-labelledby="muponto-title">
  <div class="home-shell">
    <div class="featured-heading">
      <div>
        <p class="case-status">In production</p>
        <h2 id="muponto-title">MuPonto</h2>
      </div>
      <p class="featured-deck">Time and break tracking, balance calculations, and an adjustment history in a published application.</p>
    </div>

    <figure class="system-stage" aria-labelledby="system-stage-title">
      <figcaption id="system-stage-title">From time entry to audit history</figcaption>
      <ol class="system-flow">
        <li>
          <span>Tracking and review</span>
          <strong>React + TypeScript</strong>
          <p>Time-tracking interface</p>
        </li>
        <li>
          <span>Business rules</span>
          <strong>Laravel</strong>
          <p>Calculations and auditing</p>
        </li>
        <li>
          <span>Persistence</span>
          <strong>MySQL</strong>
          <p>Records and adjustments</p>
        </li>
      </ol>
      <p class="stage-note">Architecture diagram described in the case study. It is not a product screen.</p>
    </figure>

    <dl class="case-notes">
      <div>
        <dt>Problem</dt>
        <dd>Track time and breaks without losing clarity around balances, adjustments, and exceptions.</dd>
      </div>
      <div>
        <dt>Decision</dt>
        <dd>Separate the React interface from the Laravel API and keep calculations and the audit trail on the server.</dd>
      </div>
      <div>
        <dt>Evidence</dt>
        <dd>The product is live; its repositories and technical decisions can be examined in the case study.</dd>
      </div>
    </dl>
    <div class="case-links">
      <a class="text-link" href="/projetos/gestao-de-ponto">Read the full case study <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="https://muponto.com" target="_blank" rel="noreferrer">Open the product <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="https://github.com/LucasAlvesLougon/gestao_ponto_web" target="_blank" rel="noreferrer">View the repository <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
