---
import { Image } from 'astro:assets';
import portrait from '@/assets/lucas-lougon.png';
import MobileMenu from './MobileMenu';
import LanguageToggle from './LanguageToggle.astro';
import { getTranslations, type Locale } from '@/i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const homeUrl = lang === 'pt' ? '/pt#hero' : '/#hero';
---

<section class="editorial-hero" id="hero" aria-labelledby="home-title">
  <Image src={portrait} alt="" width={1000} format="webp" loading="eager" fetchpriority="high" class="editorial-bg-image" />
  <div class="editorial-bg-overlay" aria-hidden="true"></div>

  <div class="editorial-marquee" aria-hidden="true">
    <div class="editorial-marquee-track">
      <span>Lucas &mdash; Lougon&nbsp;</span>
      <span>Lucas &mdash; Lougon&nbsp;</span>
    </div>
  </div>

  <header class="editorial-header">
    <a class="editorial-brand" href={homeUrl} aria-label={t.nav.brandAria}>Lucas</a>
    <div class="editorial-header-cluster">
      <span class="editorial-year">2026</span>
      <nav aria-label={t.nav.siteIndex}>
        <a href={t.nav.storyHref}>{t.nav.story}</a>
        <a href={t.nav.workHref}>{t.nav.work}</a>
        <a href={t.nav.messageHref}>{t.nav.message}</a>
      </nav>
      <nav aria-label={t.nav.socialLinks}>
        <a href="https://www.linkedin.com/in/lucas-lougon" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://github.com/LucasAlvesLougon" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
      <LanguageToggle currentLang={lang} variant="hero" />
    </div>

    <div class="editorial-header-mobile-actions">
      <LanguageToggle currentLang={lang} variant="mobile" />
    </div>
  </header>

  <h1 id="home-title" class="editorial-visually-hidden">{t.hero.title}</h1>

  <Image
    src={portrait}
    alt="Portrait of Lucas Lougon"
    width={1000}
    format="webp"
    loading="eager"
    fetchpriority="high"
    class="editorial-front-image"
  />

  <div class="editorial-rule" aria-hidden="true"></div>
  <footer class="editorial-footer">
    <div>
      <p>{t.hero.role1}</p>
      <p>{t.hero.role2}</p>
      <p>{t.hero.role3}</p>
    </div>
    <div class="editorial-footer-right">
      <p>{t.hero.basedIn}</p>
      <p>{t.hero.location}</p>
    </div>
  </footer>

  <MobileMenu client:load lang={lang} />
</section>

<section class="case-overview" id="caso-muponto" aria-labelledby="muponto-title">
  <div class="home-shell">
    <div class="featured-heading">
      <div>
        <p class="case-status">{t.hero.caseOverview.status}</p>
        <h2 id="muponto-title">{t.hero.caseOverview.title}</h2>
      </div>
      <p class="featured-deck">{t.hero.caseOverview.deck}</p>
    </div>

    <figure class="system-stage" aria-labelledby="system-stage-title">
      <figcaption id="system-stage-title">{t.hero.caseOverview.stageTitle}</figcaption>
      <ol class="system-flow">
        <li>
          <span>{t.hero.caseOverview.step1Tag}</span>
          <strong>{t.hero.caseOverview.step1Tech}</strong>
          <p>{t.hero.caseOverview.step1Desc}</p>
        </li>
        <li>
          <span>{t.hero.caseOverview.step2Tag}</span>
          <strong>{t.hero.caseOverview.step2Tech}</strong>
          <p>{t.hero.caseOverview.step2Desc}</p>
        </li>
        <li>
          <span>{t.hero.caseOverview.step3Tag}</span>
          <strong>{t.hero.caseOverview.step3Tech}</strong>
          <p>{t.hero.caseOverview.step3Desc}</p>
        </li>
      </ol>
      <p class="stage-note">{t.hero.caseOverview.stageNote}</p>
    </figure>

    <dl class="case-notes">
      <div>
        <dt>{t.hero.caseOverview.problemLabel}</dt>
        <dd>{t.hero.caseOverview.problemText}</dd>
      </div>
      <div>
        <dt>{t.hero.caseOverview.decisionLabel}</dt>
        <dd>{t.hero.caseOverview.decisionText}</dd>
      </div>
      <div>
        <dt>{t.hero.caseOverview.evidenceLabel}</dt>
        <dd>{t.hero.caseOverview.evidenceText}</dd>
      </div>
    </dl>
    <div class="case-links">
      <a class="text-link" href={t.hero.caseOverview.caseStudyHref}>{t.hero.caseOverview.readCaseStudy} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="https://muponto.com" target="_blank" rel="noreferrer">{t.hero.caseOverview.openProduct} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="https://github.com/LucasAlvesLougon/gestao_ponto_web" target="_blank" rel="noreferrer">{t.hero.caseOverview.viewRepository} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
