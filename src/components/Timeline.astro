---
import { getCollection } from 'astro:content';

const milestones = await getCollection('milestones');
const sortedMilestones = milestones.sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''));
---

<section class="home-section home-section-tonal" id="trajetoria" aria-labelledby="timeline-title">
  <div class="home-shell section-layout">
    <div class="section-heading">
      <h2 id="timeline-title">Registro de evolução</h2>
      <p>Entregas e decisões recentes, em ordem cronológica.</p>
    </div>
    <ol class="timeline-list">
      {sortedMilestones.map((milestone) => (
        <li>
          <time datetime={milestone.data.date}>{milestone.data.date}</time>
          <div>
            <h3>{milestone.data.title}</h3>
            <p>{milestone.data.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
