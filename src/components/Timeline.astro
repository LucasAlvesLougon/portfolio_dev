---
import { getCollection, render } from 'astro:content';

const milestones = await getCollection('milestones');
const sortedMilestones = milestones.sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''));

const milestonesWithContent = await Promise.all(
  sortedMilestones.map(async (m) => {
    const { Content } = await render(m);
    return {
      milestone: m,
      Content,
    };
  })
);
---

<section class="w-full py-16 px-6 lg:px-12 border-b border-mono-200 dark:border-mono-800" id="trajetoria">
  <div class="max-w-7xl mx-auto flex flex-col gap-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs uppercase tracking-widest font-mono text-mono-500 font-semibold">
          // Trajetória & Marcos
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold font-headline text-mono-900 dark:text-white uppercase mt-1">
          Evolução Contínua
        </h2>
      </div>
      <p class="text-xs text-mono-500 font-mono">Histórico transparente de entregas e governança</p>
    </div>

    <!-- Timeline List -->
    <div class="flex flex-col gap-4">
      {milestonesWithContent.map(({ milestone, Content }) => (
        <div class="p-5 bg-white dark:bg-mono-950 border border-mono-200 dark:border-mono-800 flex flex-col md:flex-row md:items-start justify-between gap-4">
          <div class="space-y-1.5 max-w-3xl">
            <div class="flex items-center gap-3">
              <span class="px-2 py-0.5 bg-mono-100 dark:bg-mono-900 text-mono-800 dark:text-mono-200 border border-mono-300 dark:border-mono-700 text-xs font-mono uppercase">
                {milestone.data.category || 'MARCO'}
              </span>
              <h3 class="text-base font-bold font-headline text-mono-900 dark:text-white uppercase">
                {milestone.data.title}
              </h3>
            </div>
            <p class="text-xs text-mono-600 dark:text-mono-300 leading-relaxed font-mono">
              {milestone.data.summary}
            </p>
            <div class="text-xs text-mono-500 font-sans leading-relaxed pt-1">
              <Content />
            </div>
          </div>
          <div class="text-left md:text-right font-mono text-xs text-mono-500 whitespace-nowrap">
            <span class="inline-block px-2.5 py-1 bg-mono-50 dark:bg-mono-900 border border-mono-200 dark:border-mono-800 text-mono-800 dark:text-mono-200 font-semibold">
              {milestone.data.date}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
