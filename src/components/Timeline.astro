---
import { getCollection } from 'astro:content';
import { getTranslations, type Locale } from '@/i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang).timeline;

const milestones = lang === 'pt'
  ? await getCollection('milestones_pt')
  : await getCollection('milestones');

const sortedMilestones = milestones.sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''));
---

<section class="home-section home-section-tonal" id="trajectory" aria-labelledby="timeline-title">
  <div class="home-shell section-layout">
    <div class="section-heading">
      <h2 id="timeline-title">{t.title}</h2>
      <p>{t.subtitle}</p>
    </div>
    <ol class="timeline-list">
      {sortedMilestones.map((milestone) => (
        <li>
          <time datetime={milestone.data.date}>{milestone.data.date}</time>
          <div>
            <h3>{milestone.data.title}</h3>
            <p>{milestone.data.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
