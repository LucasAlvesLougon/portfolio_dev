---
import { ThemeToggle } from './ThemeToggle';
---

<header class="sticky top-0 left-0 right-0 w-full z-40 bg-white/95 dark:bg-mono-950/95 backdrop-blur-sm border-b border-mono-200 dark:border-mono-800">
  <div class="h-16 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-4">
    <!-- Dev Identity -->
    <a href="/#hero" class="flex items-center gap-2.5 group">
      <span class="w-2.5 h-2.5 bg-mono-900 dark:bg-white inline-block"></span>
      <div class="flex flex-col">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-mono-900 dark:text-white group-hover:text-mono-600 dark:group-hover:text-mono-300 transition-colors">
          LUCAS LOUGON // DEV
        </span>
        <span class="text-[10px] font-mono text-mono-500 leading-none">Backend & Fullstack</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 font-mono text-xs uppercase tracking-wider">
      <a class="px-3 py-1.5 text-mono-600 dark:text-mono-400 hover:text-mono-900 dark:hover:text-white hover:bg-mono-100 dark:hover:bg-mono-900 transition-colors" href="/#sobre">Sobre</a>
      <a class="px-3 py-1.5 text-mono-600 dark:text-mono-400 hover:text-mono-900 dark:hover:text-white hover:bg-mono-100 dark:hover:bg-mono-900 transition-colors" href="/#especialidades">Especialidades</a>
      <a class="px-3 py-1.5 text-mono-600 dark:text-mono-400 hover:text-mono-900 dark:hover:text-white hover:bg-mono-100 dark:hover:bg-mono-900 transition-colors" href="/#projetos-destaque">Projetos</a>
      <a class="px-3 py-1.5 text-mono-600 dark:text-mono-400 hover:text-mono-900 dark:hover:text-white hover:bg-mono-100 dark:hover:bg-mono-900 transition-colors" href="/#trajetoria">Evolução</a>
      <a class="px-3 py-1.5 text-mono-600 dark:text-mono-400 hover:text-mono-900 dark:hover:text-white hover:bg-mono-100 dark:hover:bg-mono-900 transition-colors" href="/#contato-rapido">Contato</a>
    </nav>

    <!-- Action Items & Theme Switcher -->
    <div class="flex items-center gap-2 shrink-0">
      <!-- Theme Toggle Island -->
      <ThemeToggle client:load />

      <!-- Social Icons (Minimalist SVG Icons) -->
      <div class="hidden sm:flex items-center gap-1">
        <a
          aria-label="GitHub Profile"
          title="GitHub"
          class="flex items-center justify-center w-8 h-8 text-mono-600 dark:text-mono-400 hover:text-mono-900 dark:hover:text-white bg-mono-100 dark:bg-mono-900 hover:bg-mono-200 dark:hover:bg-mono-800 border border-mono-300 dark:border-mono-700 transition-colors"
          href="https://github.com/LucasAlvesLougon"
          rel="noreferrer"
          target="_blank"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            />
          </svg>
        </a>
        <a
          aria-label="LinkedIn Profile"
          title="LinkedIn"
          class="flex items-center justify-center w-8 h-8 text-mono-600 dark:text-mono-400 hover:text-mono-900 dark:hover:text-white bg-mono-100 dark:bg-mono-900 hover:bg-mono-200 dark:hover:bg-mono-800 border border-mono-300 dark:border-mono-700 transition-colors"
          href="https://www.linkedin.com/in/lucas-lougon"
          rel="noreferrer"
          target="_blank"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
            />
          </svg>
        </a>
      </div>

      <!-- Currículo CTA Button -->
      <button
        onclick="window.dispatchEvent(new CustomEvent('open-resume-modal'))"
        class="h-8 px-3 bg-mono-900 dark:bg-white hover:bg-mono-800 dark:hover:bg-mono-100 text-white dark:text-mono-950 font-mono text-xs font-semibold uppercase flex items-center gap-1.5 transition-all focus:outline-none"
      >
        <span>Currículo</span>
        <span class="material-symbols-outlined text-sm">download</span>
      </button>
    </div>
  </div>
</header>
