---
import { ThemeToggle } from './ThemeToggle';
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="/#hero" aria-label="Lucas Lougon, voltar ao início">Lucas Lougon</a>
    <nav class="site-nav" aria-label="Navegação principal">
      <a href="/#sobre">Sobre</a>
      <a href="/#especialidades">Especialidades</a>
      <a href="/#projetos-destaque">Projetos</a>
      <a href="/#trajetoria">Evolução</a>
      <a href="/#contato-rapido">Contato</a>
    </nav>
    <div class="site-header-actions">
      <ThemeToggle client:load />
      <button type="button" class="header-resume" onclick="window.dispatchEvent(new CustomEvent('open-resume-modal'))">Currículo</button>
    </div>
  </div>
</header>
